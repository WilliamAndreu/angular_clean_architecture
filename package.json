{
  "name": "angular-architecture",
  "version": "2.3.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "prepare": "husky",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "architecture": "eslint src --quiet && node scripts/check-architecture.mjs",
    "check": "pnpm architecture && pnpm test:architecture && pnpm format:check && pnpm test && pnpm build",
    "test:architecture": "node --test --test-isolation=none scripts/eslint/*.test.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@ngx-translate/core": "18.1.0",
    "@ngx-translate/http-loader": "18.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "22.6.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.3.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --max-warnings=0"
    ],
    "*.{ts,html,scss,css,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=12 <13"
  }
}
