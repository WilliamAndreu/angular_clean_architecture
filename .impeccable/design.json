  "narrative": {
    "northStar": "El escaparate claro",
    "overview": "Sistema documentado desde la implementación actual; la metáfora descriptiva «El escaparate claro» resume su tratamiento visual y no representa una dirección aprobada por el usuario. Fondo blanco, fotografía de producto sobre superficies frías y acciones azules hacen legibles las tareas de catálogo, cuenta y carrito.\n\nLa identidad se apoya en Manrope local y una bolsa geométrica dibujada con SVG. La interfaz conserva controles nativos y mensajes visibles de demostración: no comunica capacidades de pago o entrega que el producto no ofrece.",
    "keyCharacteristics": [
      "Fotografía completa sobre escenarios neutros.",
      "Jerarquía tipográfica compacta y controles explícitos.",
      "Separación mediante espacio, líneas y tono."
    ],
    "rules": [
      {
        "name": "The Action Blue Rule",
        "body": "Reservar el azul principal para identidad, navegación e interacción.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Expresar profundidad mediante tono y separación, sin añadir sombras de interfaz.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do conservar la fotografía completa mediante object-fit: contain.",
      "Do mantener etiquetas visibles, foco visible y estados recuperables.",
      "Do conservar los avisos de simulación y ocultar el resumen cuando el carrito está vacío.",
      "Do comentar las secciones HTML y CSS/SCSS en español.",
      "Priorizar utilidades Tailwind y tokens en @theme.",
      "Compartir breakpoints mobile first y evitar colisiones entre nombres de tamaños."
    ],
    "donts": [
      "Don't añadir sombras de interfaz a este sistema plano.",
      "Don't inventar checkout, promesas comerciales ni una audiencia comercial aprobada.",
      "Don't convertir los movimientos de interacción en animación ornamental."
    ]
  }
